{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "host-ui",
  "description": "Least-privilege commands for the backend-served Host UI",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "allow-get-launch-state",
    "allow-restart-host",
    "allow-get-host-status",
    "allow-enable-host-serve",
    "allow-enable-host-funnel",
    "allow-disable-host-funnel",
    "allow-get-host-prefs",
    "allow-set-host-prefs",
    "allow-set-managed-local-llm-enabled",
    "allow-get-device-location",
    "allow-export-diagnostics",
    "allow-open-external-url",
    "opener:allow-default-urls"
  ]
}
